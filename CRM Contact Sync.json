    {
      "parameters": {
        "jsCode": "const sourceContacts = $('Read CRM Source').all().map(i => i.json);\nconst targetContacts = $('Read CRM Target').all().map(i => i.json);\n\nconst targetIds = targetContacts.map(c => String(c.contact_id));\n\nconst newContacts = [];\nconst updatedContacts = [];\n\nsourceContacts.forEach(contact => {\n  const id = String(contact.contact_id);\n  \n  if (!targetIds.includes(id)) {\n    newContacts.push(contact);\n  } else {\n    const targetContact = targetContacts.find(c => String(c.contact_id) === id);\n    if (targetContact && contact.last_updated !== targetContact.last_updated) {\n      updatedContacts.push({\n        ...contact,\n        row_number: targetContact.row_number\n      });\n    }\n  }\n});\n\nreturn [{ json: { newContacts, updatedContacts } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "adfee822-20e3-4c75-a3cc-30b8aa1f2fd4",
      "name": "Detect New & Updated Contacts"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.newContacts;\nif (!data || data.length === 0) return [{ json: { skipped: true } }];\nreturn data.map(c => ({ json: c }));"
      },
